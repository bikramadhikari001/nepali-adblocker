{
    "manifest_version": 3,
    "name": "Nepali Adblocker",
    "version": "2.0.0",
    "description": "Block ads, trackers, and annoyances on Nepali websites. Clean reading mode, element picker, and more.",
    "icons": {
        "16": "src/assets/icon16.png",
        "48": "src/assets/icon48.png",
        "128": "src/assets/icon128.png"
    },
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestFeedback",
        "storage",
        "activeTab",
        "tabs",
        "alarms",
        "scripting"
    ],
    "host_permissions": [
        "*://*.onlinekhabar.com/*",
        "*://*.ekantipur.com/*",
        "*://*.setopati.com/*",
        "*://*.ratopati.com/*",
        "*://*.nagariknews.com/*",
        "*://*.hamropatro.com/*",
        "*://*.dcnepal.com/*",
        "*://*.himalkhabar.com/*",
        "*://*.krishisanjal.com/*",
        "*://*.nepalnews.com/*",
        "*://*.lokaantar.com/*",
        "*://*.baaboramedia.com/*",
        "*://*.khabarhub.com/*",
        "*://*.techmandu.com/*",
        "*://*.nepalsamaya.com/*",
        "*://*.pahilopost.com/*",
        "*://*.newsofnepal.com/*",
        "*://*.nepalpress.com/*",
        "*://*.annapurnapost.com/*",
        "*://*.karobardaily.com/*",
        "*://*.ujyaaloonline.com/*",
        "*://*.janatasamachar.com/*",
        "*://*.arthasarokar.com/*",
        "*://*.reportersnepal.com/*",
        "*://*.dainiknepal.com/*",
        "*://*.nayapage.com/*",
        "*://*.swasthyakhabar.com/*",
        "*://*.shilohost.com/*",
        "*://*.deshsanchar.com/*",
        "*://*.thahakhabar.com/*",
        "*://*.kathmandupati.com/*",
        "*://*.nepalipatra.com/*",
        "*://*.hamrakura.com/*",
        "*://*.nepalsamacharpatra.com/*",
        "*://*.himalayanews.com/*",
        "*://*.nepalkhabar.com/*",
        "*://*.bizmandu.com/*",
        "*://*.enepali.com/*",
        "*://*.janamedia.com/*",
        "*://*.notesnepal.com/*",
        "*://*.gorkhapatra.gov.np/*",
        "*://*.risingnepaldaily.com/*",
        "*://*.thegorkhapost.com/*",
        "*://*.nepalitimes.com/*",
        "*://*.kathmandupost.com/*",
        "*://*.myrepublica.nagariknetwork.com/*",
        "*://*.tkpnews.com/*",
        "*://*.nepalheadlines.com/*",
        "*://*.aarthiknews.com/*",
        "*://*.reportnepal.com/*"
    ],
    "background": {
        "service_worker": "src/background/service-worker.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.onlinekhabar.com/*",
                "*://*.ekantipur.com/*",
                "*://*.setopati.com/*",
                "*://*.ratopati.com/*",
                "*://*.nagariknews.com/*",
                "*://*.hamropatro.com/*",
                "*://*.dcnepal.com/*",
                "*://*.himalkhabar.com/*",
                "*://*.krishisanjal.com/*",
                "*://*.nepalnews.com/*",
                "*://*.lokaantar.com/*",
                "*://*.baaboramedia.com/*",
                "*://*.khabarhub.com/*",
                "*://*.techmandu.com/*",
                "*://*.nepalsamaya.com/*",
                "*://*.pahilopost.com/*",
                "*://*.newsofnepal.com/*",
                "*://*.nepalpress.com/*",
                "*://*.annapurnapost.com/*",
                "*://*.karobardaily.com/*",
                "*://*.ujyaaloonline.com/*",
                "*://*.janatasamachar.com/*",
                "*://*.arthasarokar.com/*",
                "*://*.reportersnepal.com/*",
                "*://*.dainiknepal.com/*",
                "*://*.nayapage.com/*",
                "*://*.swasthyakhabar.com/*",
                "*://*.deshsanchar.com/*",
                "*://*.thahakhabar.com/*",
                "*://*.kathmandupati.com/*",
                "*://*.nepalipatra.com/*",
                "*://*.hamrakura.com/*",
                "*://*.nepalsamacharpatra.com/*",
                "*://*.himalayanews.com/*",
                "*://*.nepalkhabar.com/*",
                "*://*.bizmandu.com/*",
                "*://*.enepali.com/*",
                "*://*.janamedia.com/*",
                "*://*.gorkhapatra.gov.np/*",
                "*://*.risingnepaldaily.com/*",
                "*://*.thegorkhapost.com/*",
                "*://*.nepalitimes.com/*",
                "*://*.kathmandupost.com/*",
                "*://*.myrepublica.nagariknetwork.com/*",
                "*://*.nepalheadlines.com/*",
                "*://*.aarthiknews.com/*",
                "*://*.reportnepal.com/*"
            ],
            "js": [
                "src/content/cosmetic-filter.ts",
                "src/content/cookie-consent.ts",
                "src/content/anti-adblock.ts",
                "src/content/element-picker.ts",
                "src/content/reader-mode.ts"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "src/assets/icon16.png",
            "48": "src/assets/icon48.png"
        }
    },
    "options_page": "src/options/options.html",
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "nepali_ads",
                "enabled": true,
                "path": "rules/nepali-rules.json"
            },
            {
                "id": "easylist_mini",
                "enabled": true,
                "path": "rules/easylist-mini-rules.json"
            },
            {
                "id": "trackers",
                "enabled": true,
                "path": "rules/tracker-rules.json"
            }
        ]
    }
}